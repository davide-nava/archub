# ==============================================================================
# Google Antigravity Ignore Configuration (.geminiignore)
# Excludes files and directories from AI agent indexing, search, and context.
# ==============================================================================

# Dependencies & Package Managers
**/node_modules/
**/vendor/
**/.dart_tool/
**/.pub-cache/
**/.pub/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Compilation & Build Outputs
**/dist/
**/build/
**/out-tsc/
**/bazel-out/
**/.angular/
**/.sass-cache/

# Laravel Storage & Framework Cache
**/storage/framework/cache/
**/storage/framework/sessions/
**/storage/framework/views/
**/storage/framework/testing/
**/bootstrap/cache/packages.php
**/bootstrap/cache/services.php
**/public/build/
**/public/hot
**/public/storage

# Native Mobile Platform Builds
**/android/.gradle/
**/android/app/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# Databases & SQLite
**/*.sqlite*
**/*.sqlite-wal
**/*.sqlite-shm
**/database.sqlite

# Test Coverage & Artifacts
**/coverage/
**/.nyc_output/
**/test-results/
**/__screenshots__/
**/*.lcov
**/.phpunit.cache/
**/.phpunit.result.cache

# Logs & Runtime Dumps
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Secrets & Sensitive Environment Files
**/.env
**/.env.*
!**/.env.example
**/auth.json
**/*.key
**/*.keystore
**/*.jks
**/*.pem
**/*.cert
**/*.crt

# IDE & Editor Metadata
**/.idea/
**/.fleet/
**/.zed/
**/.cursor/
**/.history/
**/*.iml
**/*.ipr
**/*.iws

# Operating System Files
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db
